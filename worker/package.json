{
  "name": "@mt/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply maimai-toolbox --local",
    "migrate:remote": "wrangler d1 migrations apply maimai-toolbox --remote",
    "invite": "node scripts/invite.mjs",
    "typecheck": "tsc -p .",
    "test": "tsx --test src/*.test.ts",
    "cf:login": "node scripts/login.mjs"
  },
  "dependencies": {
    "@mt/shared": "workspace:*",
    "hono": "4.9.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251008.0",
    "@types/node": "24.7.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.42.0"
  }
}

{
  "name": "maimai-toolbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter ./worker --filter ./web dev",
    "dev:worker": "pnpm --filter ./worker dev",
    "dev:web": "pnpm --filter ./web dev",
    "build": "pnpm --filter ./web build",
    "deploy": "pnpm build && pnpm --filter ./worker deploy",
    "db:migrate:local": "pnpm --filter ./worker migrate:local",
    "db:migrate:remote": "pnpm --filter ./worker migrate:remote",
    "invite": "pnpm --filter ./worker invite",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "cf:login": "pnpm --filter ./worker cf:login"
  }
}
